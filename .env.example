# Copy to .env and fill in. Never commit .env.

# --- Upstream provider ---
# Any OpenAI-compatible API. Groq: https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Used when the calling app doesn't send its own key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Security ---
# Per-team proxy keys: team:key,team:key (keys 16+ chars). Generate one with:
#   python3 -c "import secrets; print('k_' + secrets.token_urlsafe(24))"
# When set, callers must send X-Cost-Guard-Key and their team comes from the key.
# Leave empty only for local development.
COST_GUARD_KEYS=
# Password for the dashboard and /stats (user: DASHBOARD_USER, default admin)
DASHBOARD_PASSWORD=
DASHBOARD_USER=admin
# Reject request bodies larger than this (bytes)
MAX_BODY_BYTES=1000000

# --- Budgets ---
# Daily USD limit per team; calls get HTTP 429 once reached. e.g. search:5,support:2.50
BUDGETS=

# --- Cache ---
# deterministic (cache only temperature=0 calls) | all | off
CACHE_MODE=deterministic
CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT=120
